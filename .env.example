# Copy to .env (git-ignored) and point at the discs you own; a title without one gets no picker panel.
# Each title reads its own key (environment, then this file), then PSXPORT_DISC, then a *.chd in the repo root.
PSXPORT_TOMBA1_DISC=/path/to/Tomba! (USA).chd
PSXPORT_TOMBA2_DISC=/path/to/Tomba! 2 - The Evil Swine Return (USA).chd
